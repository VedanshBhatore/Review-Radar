# Copy this file to .env.local and fill in what you have. Nothing here is required --
# with no keys set at all, ReviewRadar runs fully offline in "Demo mode" (mock LLM
# provider + local JSON file storage under .data/).

# --- LLM provider ---------------------------------------------------------
# One of: claude | gemini | mock
# If unset, the app auto-picks claude (if ANTHROPIC_API_KEY is set), else gemini
# (if GEMINI_API_KEY is set), else falls back to mock.
LLM_PROVIDER=

# Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Defaults shown below are used if these are unset.
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_SMART_MODEL=claude-sonnet-5-5

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_SMART_MODEL=gemini-3.8-flash

# --- Storage ---------------------------------------------------------------
# Set BOTH to use Supabase (required in production -- Vercel's filesystem is
# ephemeral). Leave both blank to use local JSON files under .data/ (dev only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Analytics ---------------------------------------------------------------
# PostHog project API key (https://posthog.com). If unset, analytics calls are
# silently no-ops -- the app still works, you just won't get event data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
